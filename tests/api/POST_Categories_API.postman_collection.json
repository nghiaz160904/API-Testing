	"item": [
		{
			"name": "Test Cases for POST /categories",
			"item": [
				{
					"name": "TC1 - Create root category (success)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function() {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response should contain created category\", function() {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.name).to.eql('New Category');",
									"    pm.expect(jsonData.slug).to.eql('new-category');",
									"    pm.expect(jsonData.parent_id).to.be.null;",
									"});",
									"",
									"pm.test(\"Should have created_at timestamp\", function() {",
									"    pm.expect(pm.response.json().created_at).to.exist;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"New Category\",\n  \"slug\": \"new-category\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/categories",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"categories"
							]
						}
					},
					"response": []
				},
				{
					"name": "TC2 - Create subcategory (success)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function() {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Should have correct parent_id\", function() {",
									"    pm.expect(pm.response.json().parent_id).to.eql(1);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"New Subcategory\",\n  \"slug\": \"new-sub\",\n  \"parent_id\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/categories",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"categories"
							]
						}
					},
					"response": []
				},
				{
					"name": "TC3 - Missing required fields (error)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 422\", function() {",
									"    pm.response.to.have.status(422);",
									"});",
									"",
									"pm.test(\"Should have validation errors\", function() {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.errors).to.exist;",
									"    pm.expect(jsonData.message).to.include('validation');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"New Category\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/categories",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"categories"
							]
						}
					},
					"response": []
