							"raw": "{\n  \"name\": \"Existing Category\",\n  \"slug\": \"electronics\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/categories",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"categories"
							]
						}
					},
					"response": []
