				{
					"name": "TC4 - Duplicate slug (error)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 422\", function() {",
									"    pm.response.to.have.status(422);",
									"});",
									"",
									"pm.test(\"Should have slug error\", function() {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.errors.slug).to.exist;",
									"});"
								],
								"type": "text/javascript"
							}
						}
